# OpenRouter image generation (optional).
#
# When set, the "GENERATE 👶" flow calls OpenRouter server-side to produce a
# STRICTLY cartoon baby avatar. When unset (or if the call fails / rate-limits /
# times out), the app falls back to the built-in local SVG cartoon renderer —
# the full flow still works with zero configuration.
#
# Get a key: https://openrouter.ai/keys
#   (create an account, then "Create API Key"; keys start with "sk-or-v1-…")
#
OPENROUTER_API_KEY=

# Optional: override the default image model (google/gemini-2.5-flash-image).
# Allowed: google/gemini-2.5-flash-image, google/gemini-2.5-flash-image-preview,
#          google/gemini-3-flash-image-preview, black-forest-labs/flux.2-flex,
#          black-forest-labs/flux.2-pro
# OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
